# Ví dụ các biến môi trường; không đưa mật khẩu thật vào Git.
ESHOP_DB_USER=root
ESHOP_DB_PASSWORD=YOUR_MARIADB_PASSWORD
# Tùy chọn: khóa JWT Base64 (ít nhất 32 byte); để trống thì mỗi lần chạy tự sinh khóa tạm.
ESHOP_JWT_SECRET=
# Giai đoạn 6: dùng cùng API key cho embedding và chat khi bật profile ai-dev.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash

# Giai đoạn 7: áp dụng migration V007 trước khi bật thu thập analytics.
ESHOP_TRACKING_ENABLED=false
ESHOP_TRACKING_RETENTION_DAYS=30
ESHOP_TRACKING_ZONE=Asia/Ho_Chi_Minh
